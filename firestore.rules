rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.level;
    }

    function getUserName() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.nama is string
             && profile.nama != ''
             && profile.nama != '(tanpa nama)'
        ? profile.nama
        : request.auth.token.email;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isRole(role) {
      return isSignedIn() && getUserRole() == role;
    }

    function onlyChangedFields(allowedFields) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(allowedFields);
    }

    function fieldChanged(field) {
      return field in request.resource.data.diff(resource.data).affectedKeys();
    }

    match /users/{userId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == userId || isRole('kepala_bengkel'));
      allow write: if false;
    }

    match /unitWip/{unitId} {
      allow read: if isSignedIn();

      allow create: if isRole('service_advisor')
                    && request.resource.data.keys().hasAll(
                         ['noWO', 'tipeKendaraan', 'tanggalMasuk', 'jumlahPanel',
                          'estimasiBiaya', 'statusSparepart', 'statusSpkAsuransi',
                          'statusPengerjaan', 'createdBy', 'updatedAt']
                       )
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.statusPengerjaan == 'menunggu'
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.jumlahPanel is int
                    && request.resource.data.jumlahPanel > 0
                    && request.resource.data.estimasiBiaya is number
                    && request.resource.data.estimasiBiaya > 0
                    && request.resource.data.noWO is string
                    && request.resource.data.noWO.size() > 0
                    && request.resource.data.tipeKendaraan is string
                    && request.resource.data.tipeKendaraan.size() > 0
                    && request.resource.data.statusSparepart in ['ready', 'order_eo', 'back_order']
                    && request.resource.data.statusSpkAsuransi in ['disetujui', 'proses_klaim', 'bermasalah'];

      allow update: if
        ( isRole('service_advisor')
          && onlyChangedFields(['noWO','tipeKendaraan','tanggalMasuk','jumlahPanel',
                                'estimasiBiaya','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (!fieldChanged('jumlahPanel')
              || (request.resource.data.jumlahPanel is int && request.resource.data.jumlahPanel > 0))
          && (!fieldChanged('estimasiBiaya')
              || (request.resource.data.estimasiBiaya is number && request.resource.data.estimasiBiaya > 0)) )
        ||
        ( isRole('partman')
          && onlyChangedFields(['statusSparepart','statusSpkAsuransi',
                                'statusSparepartUpdatedBy','statusSpkAsuransiUpdatedBy',
                                'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && (!fieldChanged('statusSparepart')
              || (request.resource.data.statusSparepart in ['ready', 'order_eo', 'back_order']
                  && request.resource.data.statusSparepartUpdatedBy == getUserName()))
          && (!fieldChanged('statusSpkAsuransi')
              || (request.resource.data.statusSpkAsuransi in ['disetujui', 'proses_klaim', 'bermasalah']
                  && request.resource.data.statusSpkAsuransiUpdatedBy == getUserName()))
          && (!fieldChanged('statusSparepartUpdatedBy')
              || fieldChanged('statusSparepart'))
          && (!fieldChanged('statusSpkAsuransiUpdatedBy')
              || fieldChanged('statusSpkAsuransi')) )
        ||
        ( isRole('kepala_bengkel')
          && onlyChangedFields(['statusPengerjaan','updatedAt'])
          && request.resource.data.updatedAt == request.time
          && resource.data.statusPengerjaan == 'menunggu'
          && request.resource.data.statusPengerjaan == 'sedang_dikerjakan'
          && resource.data.statusSparepart == 'ready'
          && resource.data.statusSpkAsuransi == 'disetujui' );

      allow delete: if isRole('service_advisor')
                    && resource.data.createdBy == request.auth.uid;
    }

    match /hasilRanking/{rankingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /kriteriaSMART/{kriteriaId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
